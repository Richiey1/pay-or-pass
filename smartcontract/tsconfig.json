{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "typeRoots": ["./node_modules/@types"],
    "types": ["node", "mocha", "chai", "hardhat"]
  },
  "include": ["./scripts", "./test", "./typechain-types", "./x-loop"],
  "files": ["./hardhat.config.ts"],
  "exclude": ["node_modules", "dist"]
}
